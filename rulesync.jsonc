{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "claudecode": {
      "rules": { "includeRoot": false },
      "commands": true,
      "subagents": true,
      "skills": true
    },
    "codexcli": {
      "subagents": true,
      "skills": true,
      "gitignoreDestination": "gitexclude"
    },
    "copilot": ["rules", "commands", "subagents", "skills"],
    "copilotcli": ["rules", "subagents", "skills"],
    "antigravity-ide": {
      "commands": true,
      "subagents": true,
      "skills": true,
      "gitignoreDestination": "gitexclude"
    },
    "antigravity-cli": {
      "commands": true,
      "subagents": true,
      "skills": true,
      // Antigravity skips .gitignore entries; use Git's local exclude instead.
      "gitignoreDestination": "gitexclude"
    },
    "agentsskills": ["skills"]
  },
  "outputRoots": ["."],
  "delete": true,
  "sources": [
    {
      "source": "mols3131d/mols-agent-assets",
      "skills": [
        "artifact-consistency-inspector",
        "check-dependencies",
        "code-flow-map",
        "coding-context",
        "github-context",
        "mols-agent-asset",
        "mols-agent-asset-find",
        "mols-ci-design",
        "mols-clarify-code",
        "mols-clarify-runtime",
        "mols-code-comprehension-refactor",
        "mols-dev-env-bootstrap-design",
        "mols-documentation",
        "mols-loops",
        "mols-markdown-maintenance",
        "mols-mermaid-diagram",
        "mols-test-design",
        "review-changes",
        "searcher",
        "technical-document-fidelity"
      ],
      "transport": "github",
      "ref": "main",
      "path": "src/rulesync/.rulesync/skills"
    },
    {
      "source": "dyoshikawa/rulesync",
      "skills": ["rulesync"],
      "transport": "github",
      "ref": "main",
      "path": "skills"
    }
  ]
}
